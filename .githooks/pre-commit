#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────
# Atenea · pre-commit · protege ramas permanentes (manual de versionado Venteks)
#
# Regla del md: "nunca desarrolles directo sobre main". El desarrollo va en ramas
# temporales (feat/ fix/ chore/) desde beta; hotfix/ desde main. Este hook
# bloquea commits DIRECTOS sobre main o beta.
#
# Escape para promoción/merge de release:  ATENEA_ALLOW_PROTECTED=1 git commit ...
# Bypass total puntual:                     git commit --no-verify
# ─────────────────────────────────────────────────────────────────────────

[ "${ATENEA_ALLOW_PROTECTED:-}" = "1" ] && exit 0

branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo '')"

case "$branch" in
  main|beta)
    cat >&2 <<EOF
✕ Atenea · commit directo sobre '$branch' bloqueado.

  El desarrollo va en ramas temporales:
    feat/<func> · fix/<bug> · chore/<ajuste>   (desde beta)
    hotfix/<bug>                                  (desde main)

  Crea la rama y muévete a ella:
    git switch -c feat/mi-cambio

  Promoción de release (merge a $branch):  ATENEA_ALLOW_PROTECTED=1 git commit ...
  Bypass puntual (no recomendado):         git commit --no-verify
EOF
    exit 1
    ;;
esac

exit 0
