{
  "name": "@acertijosapps/react-native-md-document",
  "version": "1.0.0",
  "description": "Immutable Markdown-as-document viewer for React Native: page-flip, zoom, text-to-speech and persistent highlights.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "ios",
    "android",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx",
    "react-native.config.js",
    "react-native-document.podspec",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Acertijos Apps <bgoswaldo@gmail.com>",
  "scripts": {
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "keywords": [
    "react-native",
    "markdown",
    "pdf",
    "viewer",
    "tts",
    "highlight"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.76.5",
    "@types/react": "^18.3.12",
    "eslint": "^8.57.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-native": "^0.76.5",
    "react-native-gesture-handler": "^2.20.2",
    "react-native-reanimated": "^3.16.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
